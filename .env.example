# Hope frontend env vars — copy this to .env.local for your machine.
# .env.local is gitignored; .env.example is committed as the template.

# Base URL of the Hope backend API (deployed on Render).
# In dev you can also point this at http://localhost:5000 if you run the backend locally.
NEXT_PUBLIC_API_BASE_URL=https://hope-backend-91e6.onrender.com
